<!DOCTYPE html>
<html>
  <head>
    <title>Diagon Alley Emporium</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <%= javascript_importmap_tags %>
    
    <!-- Custom styles -->
    <style>
      .navbar-brand {
        font-weight: bold;
        font-size: 1.5rem;
      }
      .product-card {
        transition: transform 0.2s;
      }
      .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      }
      .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
      }
      .btn {
        transition: all 0.2s ease-in-out;
      }
    </style>
  </head>

  <body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <%= link_to "Diagon Alley Emporium 🧙‍♂️", root_path, class: "navbar-brand" %>
        
        <div class="navbar-nav me-auto">
          <%= link_to "Products", products_path, class: "nav-link" %>
          <%= link_to "Categories", categories_path, class: "nav-link" %>
        </div>
        
        <div class="navbar-nav">
          <% if user_signed_in? %>
            <%= link_to shopping_carts_path, class: "nav-link" do %>
              Cart
              <% if @current_cart_count && @current_cart_count > 0 %>
                <span class="badge bg-danger"><%= @current_cart_count %></span>
              <% end %>
            <% end %>
            <%= link_to "Orders", orders_path, class: "nav-link" %>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_root_path, class: "nav-link" %>
            <% end %>
            <%= link_to "Logout", destroy_user_session_path, data: { "turbo-method": :delete }, class: "nav-link" %>
          <% else %>
            <%= link_to "Cart", shopping_carts_path, class: "nav-link" %>
            <%= link_to "Login", new_user_session_path, class: "nav-link" %>
            <%= link_to "Register", new_user_registration_path, class: "nav-link" %>
          <% end %>
        </div>
      </div>
    </nav>

    <!-- Flash messages -->
    <% if notice %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= notice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>
    
    <% if alert %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= alert %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <!-- Main content -->
    <main class="container mt-4">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-5 py-4">
      <div class="container">
        <div class="row">
          <div class="col-md-6">
            <h5>Diagon Alley Emporium</h5>
            <p>Your trusted source for magical items since 1692.</p>
          </div>
          <div class="col-md-6">
            <h5>Quick Links</h5>
            <ul class="list-unstyled">
              <li><%= link_to "Products", products_path, class: "text-light" %></li>
              <li><%= link_to "About", "#", class: "text-light" %></li>
              <li><%= link_to "Contact", "#", class: "text-light" %></li>
            </ul>
          </div>
        </div>
        <hr class="mt-3">
        <div class="text-center">
          <small>&copy; 2025 Diagon Alley Emporium. Created by Luke Lu for Full Stack Development Course.</small>
        </div>
      </div>
    </footer>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
