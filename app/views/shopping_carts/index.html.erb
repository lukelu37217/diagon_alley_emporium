<div class="container mt-4">
  <h1>Shopping Cart</h1>
  
  <% if @cart_items.any? %>
    <div class="row">
      <div class="col-md-8">
        <% @cart_items.each do |item| %>
          <div class="card mb-3">
            <div class="card-body">
              <div class="row align-items-center">
                <div class="col-md-2">
                  <% if item.product.images.attached? %>
                    <%= image_tag item.product.images.first, class: "img-fluid", style: "height: 80px; object-fit: cover;" %>
                  <% else %>
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 80px;">
                      <span class="text-muted">No Image</span>
                    </div>
                  <% end %>
                </div>
                <div class="col-md-4">
                  <h5><%= item.product.name %></h5>
                  <p class="text-muted"><%= item.product.category.name %></p>
                </div>
                <div class="col-md-2">
                  <strong>$<%= item.product.current_price %></strong>
                </div>
                <div class="col-md-2">
                  <%= form_with model: item, url: update_item_shopping_cart_path(item), method: :patch, local: true, class: "d-flex align-items-center" do |f| %>
                    <%= f.number_field :quantity, value: item.quantity, min: 1, class: "form-control form-control-sm", style: "width: 70px;" %>
                    <%= f.submit "Update", class: "btn btn-sm btn-outline-primary ms-2" %>
                  <% end %>
                </div>
                <div class="col-md-2">
                  <%= link_to remove_item_shopping_cart_path(item), method: :delete, 
                              confirm: "Remove this item?", 
                              class: "btn btn-sm btn-outline-danger" do %>
                    <i class="fas fa-trash"></i>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <div class="col-md-4">
        <div class="card">
          <div class="card-header">
            <h5>Order Summary</h5>
          </div>
          <div class="card-body">
            <% total = @cart_items.sum { |item| item.product.current_price * item.quantity } %>
            <p><strong>Total: $<%= total %></strong></p>
            
            <div class="d-grid gap-2">
              <%= link_to "Proceed to Checkout", new_order_path, class: "btn btn-primary" %>
              <%= link_to "Continue Shopping", products_path, class: "btn btn-outline-secondary" %>
              <%= link_to "Clear Cart", clear_shopping_carts_path, method: :delete, 
                          confirm: "Clear entire cart?", 
                          class: "btn btn-outline-danger" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="text-center py-5">
      <i class="fas fa-shopping-cart fa-5x text-muted mb-3"></i>
      <h3>Your cart is empty</h3>
      <p class="text-muted">Add some magical items to get started!</p>
      <%= link_to "Browse Products", products_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
