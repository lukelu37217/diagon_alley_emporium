<div class="container-fluid mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Edit Product</h2>
    <%= link_to "Back to Products", admin_products_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="card shadow">
    <div class="card-body">
      <%= form_with model: [:admin, @product], local: true, multipart: true do |f| %>
        <% if @product.errors.any? %>
          <div class="alert alert-danger">
            <h6><%= pluralize(@product.errors.count, "error") %> prohibited this product from being saved:</h6>
            <ul class="mb-0">
              <% @product.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="row">
          <div class="col-md-8">
            <div class="mb-3">
              <%= f.label :name, class: "form-label" %>
              <%= f.text_field :name, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :description, class: "form-label" %>
              <%= f.text_area :description, class: "form-control", rows: 4 %>
            </div>

            <div class="row">
              <div class="col-md-6">
                <%= f.label :price, class: "form-label" %>
                <div class="input-group mb-3">
                  <span class="input-group-text">$</span>
                  <%= f.number_field :price, step: 0.01, class: "form-control" %>
                </div>
              </div>
              <div class="col-md-6">
                <%= f.label :stock_quantity, "Stock Quantity", class: "form-label" %>
                <%= f.number_field :stock_quantity, class: "form-control mb-3" %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :category_id, "Category", class: "form-label" %>
              <%= f.select :category_id, options_from_collection_for_select(Category.all, :id, :name, @product.category_id), 
                  { prompt: "Select a category" }, { class: "form-select" } %>
            </div>

            <div class="mb-3">
              <div class="form-check">
                <%= f.check_box :is_active, class: "form-check-input" %>
                <%= f.label :is_active, "Active Product", class: "form-check-label" %>
              </div>
            </div>
          </div>

          <div class="col-md-4">
            <div class="mb-3">
              <%= f.label :images, "Product Images", class: "form-label" %>
              <%= f.file_field :images, multiple: true, accept: "image/*", class: "form-control" %>
              <div class="form-text">You can select multiple images.</div>
            </div>

            <% if @product.images.attached? %>
              <div class="current-images">
                <h6>Current Images:</h6>
                <div class="row g-2">
                  <% @product.images.each do |image| %>
                    <div class="col-6">
                      <%= image_tag image, class: "img-thumbnail", style: "height: 100px; object-fit: cover;" %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
          <%= link_to "Cancel", admin_products_path, class: "btn btn-outline-secondary" %>
          <%= f.submit "Update Product", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
