<div class="container-fluid mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Product Details</h2>
    <div>
      <%= link_to "Edit", edit_admin_product_path(@product), class: "btn btn-primary" %>
      <%= link_to "Back to Products", admin_products_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="card shadow">
        <div class="card-header">
          <h5>Product Images</h5>
        </div>
        <div class="card-body">
          <% if @product.images.attached? %>
            <div class="row g-3">
              <% @product.images.each do |image| %>
                <div class="col-md-6">
                  <%= image_tag image, class: "img-fluid rounded", style: "height: 200px; object-fit: cover; width: 100%;" %>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-4">
              <i class="fas fa-image fa-3x text-muted mb-3"></i>
              <p class="text-muted">No images uploaded</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card shadow">
        <div class="card-header">
          <h5>Product Information</h5>
        </div>
        <div class="card-body">
          <table class="table table-borderless">
            <tr>
              <th width="30%">Name:</th>
              <td><%= @product.name %></td>
            </tr>
            <tr>
              <th>Description:</th>
              <td><%= @product.description %></td>
            </tr>
            <tr>
              <th>Price:</th>
              <td><strong>$<%= @product.current_price %></strong></td>
            </tr>
            <tr>
              <th>Stock:</th>
              <td>
                <% if @product.stock_quantity > 0 %>
                  <span class="badge bg-success"><%= @product.stock_quantity %> in stock</span>
                <% else %>
                  <span class="badge bg-danger">Out of stock</span>
                <% end %>
              </td>
            </tr>
            <tr>
              <th>Category:</th>
              <td><span class="badge bg-secondary"><%= @product.category.name %></span></td>
            </tr>
            <tr>
              <th>Status:</th>
              <td>
                <% if @product.is_active? %>
                  <span class="badge bg-success">Active</span>
                <% else %>
                  <span class="badge bg-danger">Inactive</span>
                <% end %>
              </td>
            </tr>
            <tr>
              <th>Created:</th>
              <td><%= @product.created_at.strftime("%B %d, %Y at %I:%M %p") %></td>
            </tr>
            <tr>
              <th>Last Updated:</th>
              <td><%= @product.updated_at.strftime("%B %d, %Y at %I:%M %p") %></td>
            </tr>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
