<div class="container-fluid mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Category Details</h2>
    <div class="btn-group">
      <%= link_to "Edit Category", edit_admin_category_path(@category), class: "btn btn-primary" %>
      <%= link_to "Back to Categories", admin_categories_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-header">
          <h5 class="card-title mb-0">Category Information</h5>
        </div>
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-sm-3">
              <strong>Name:</strong>
            </div>
            <div class="col-sm-9">
              <%= @category.name %>
            </div>
          </div>
          
          <div class="row mb-3">
            <div class="col-sm-3">
              <strong>Description:</strong>
            </div>
            <div class="col-sm-9">
              <%= @category.description || "No description provided" %>
            </div>
          </div>
          
          <div class="row mb-3">
            <div class="col-sm-3">
              <strong>Status:</strong>
            </div>
            <div class="col-sm-9">
              <% if @category.is_active? %>
                <span class="badge bg-success">Active</span>
              <% else %>
                <span class="badge bg-danger">Inactive</span>
              <% end %>
            </div>
          </div>
          
          <div class="row mb-3">
            <div class="col-sm-3">
              <strong>Products Count:</strong>
            </div>
            <div class="col-sm-9">
              <span class="badge bg-info"><%= @category.products.count %> products</span>
            </div>
          </div>
          
          <div class="row mb-3">
            <div class="col-sm-3">
              <strong>Created:</strong>
            </div>
            <div class="col-sm-9">
              <%= @category.created_at.strftime("%B %d, %Y at %I:%M %p") %>
            </div>
          </div>
          
          <div class="row mb-3">
            <div class="col-sm-3">
              <strong>Last Updated:</strong>
            </div>
            <div class="col-sm-9">
              <%= @category.updated_at.strftime("%B %d, %Y at %I:%M %p") %>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <div class="card shadow">
        <div class="card-header">
          <h5 class="card-title mb-0">Products in this Category</h5>
        </div>
        <div class="card-body">
          <% if @category.products.any? %>
            <% @category.products.limit(10).each do |product| %>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                  <%= link_to product.name, admin_product_path(product), class: "text-decoration-none" %>
                  <% unless product.is_active? %>
                    <span class="badge bg-warning ms-1">Inactive</span>
                  <% end %>
                </div>
                <small class="text-muted">$<%= product.current_price %></small>
              </div>
            <% end %>
            
            <% if @category.products.count > 10 %>
              <div class="mt-2">
                <small class="text-muted">... and <%= @category.products.count - 10 %> more products</small>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted">No products in this category yet.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
