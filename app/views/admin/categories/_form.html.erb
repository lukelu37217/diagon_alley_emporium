<div class="container-fluid mt-4">
  <h2><%= @category.persisted? ? "Edit Category" : "New Category" %></h2>
  
  <%= form_with model: [:admin, @category], local: true, class: "needs-validation", novalidate: true do |f| %>
    <% if @category.errors.any? %>
      <div class="alert alert-danger">
        <h4><%= pluralize(@category.errors.count, "error") %> prohibited this category from being saved:</h4>
        <ul class="mb-0">
          <% @category.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="row">
      <div class="col-md-8">
        <div class="card">
          <div class="card-header">
            <h5>Category Information</h5>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <%= f.label :name, class: "form-label" %>
              <%= f.text_field :name, class: "form-control", required: true %>
              <div class="invalid-feedback">Please provide a category name.</div>
            </div>

            <div class="mb-3">
              <%= f.label :description, class: "form-label" %>
              <%= f.text_area :description, class: "form-control", rows: 4 %>
              <div class="form-text">Optional description for this category</div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card">
          <div class="card-header">
            <h5>Category Status</h5>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <div class="form-check">
                <%= f.check_box :is_active, class: "form-check-input" %>
                <%= f.label :is_active, "Active Category", class: "form-check-label" %>
              </div>
              <div class="form-text">Inactive categories won't be visible to customers</div>
            </div>
          </div>
        </div>

        <div class="card mt-3">
          <div class="card-header">
            <h5>Actions</h5>
          </div>
          <div class="card-body">
            <div class="d-grid gap-2">
              <%= f.submit @category.persisted? ? "Update Category" : "Create Category", class: "btn btn-primary" %>
              <%= link_to "Cancel", admin_categories_path, class: "btn btn-outline-secondary" %>
              <% if @category.persisted? %>
                <%= link_to "View Category", category_path(@category), class: "btn btn-outline-info", target: "_blank" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
  // Bootstrap form validation
  (function() {
    'use strict';
    window.addEventListener('load', function() {
      var forms = document.getElementsByClassName('needs-validation');
      var validation = Array.prototype.filter.call(forms, function(form) {
        form.addEventListener('submit', function(event) {
          if (form.checkValidity() === false) {
            event.preventDefault();
            event.stopPropagation();
          }
          form.classList.add('was-validated');
        }, false);
      });
    }, false);
  })();
</script>
