<div class="container-fluid mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Categories Management</h2>
    <%= link_to "Add New Category", new_admin_category_path, class: "btn btn-primary" %>
  </div>

  <div class="card shadow">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-striped table-hover">
          <thead class="table-dark">
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Description</th>
              <th>Products Count</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% Category.includes(:products).each do |category| %>
              <tr>
                <td><%= category.id %></td>
                <td><strong><%= category.name %></strong></td>
                <td><%= truncate(category.description, length: 50) if category.respond_to?(:description) %></td>
                <td>
                  <span class="badge bg-info"><%= category.products.count %> products</span>
                </td>
                <td>
                  <% if category.is_active? %>
                    <span class="badge bg-success">Active</span>
                  <% else %>
                    <span class="badge bg-danger">Inactive</span>
                  <% end %>
                </td>
                <td>
                  <div class="btn-group" role="group">
                    <%= link_to "View", admin_category_path(category), class: "btn btn-sm btn-outline-primary" %>
                    <%= link_to "Edit", edit_admin_category_path(category), class: "btn btn-sm btn-outline-secondary" %>
                    <%= link_to "Delete", admin_category_path(category), method: :delete, 
                        data: { 
                          confirm: "Are you sure you want to delete '#{category.name}'? This action cannot be undone.",
                          turbo_method: :delete
                        }, class: "btn btn-sm btn-outline-danger" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
