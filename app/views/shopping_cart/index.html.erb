<div class="container mt-4">
  <h1>Shopping Cart</h1>
  
  <% if @cart_items.any? %>
    <div class="row">
      <div class="col-md-8">
        <% @cart_items.each do |item| %>
          <div class="card mb-3">
            <div class="card-body">
              <div class="row align-items-center">
                <div class="col-md-2">
                  <% if item.product.image.attached? %>
                    <%= image_tag item.product.image, class: "img-fluid" %>
                  <% else %>
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 80px;">
                      <span class="text-muted">No Image</span>
                    </div>
                  <% end %>
                </div>
                
                <div class="col-md-4">
                  <h5><%= link_to item.product.name, product_path(item.product) %></h5>
                  <p class="text-muted">$<%= item.product.price %></p>
                </div>
                
                <div class="col-md-3">
                  <%= form_with model: item, url: shopping_cart_path(item), method: :patch, local: true, class: "d-flex align-items-center" do |form| %>
                    <%= form.number_field :quantity, value: item.quantity, min: 1, max: item.product.stock_quantity, class: "form-control me-2", style: "width: 80px;" %>
                    <%= form.submit "Update", class: "btn btn-sm btn-outline-primary" %>
                  <% end %>
                </div>
                
                <div class="col-md-2">
                  <strong>$<%= (item.quantity * item.product.price).round(2) %></strong>
                </div>
                
                <div class="col-md-1">
                  <%= link_to "×", shopping_cart_path(item), method: :delete, 
                      class: "btn btn-outline-danger btn-sm",
                      data: { confirm: "Are you sure?" } %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <div class="col-md-4">
        <div class="card">
          <div class="card-header">
            <h5>Order Summary</h5>
          </div>
          <div class="card-body">
            <div class="d-flex justify-content-between">
              <span>Subtotal:</span>
              <strong>$<%= @total.round(2) %></strong>
            </div>
            <hr>
            <div class="d-flex justify-content-between">
              <span>Total:</span>
              <strong class="h5">$<%= @total.round(2) %></strong>
            </div>
            
            <%= link_to "Proceed to Checkout", new_order_path, class: "btn btn-primary btn-lg w-100 mt-3" %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="text-center py-5">
      <h3>Your cart is empty</h3>
      <p class="text-muted">Add some magical items to your cart!</p>
                  <%= link_to "Browse Products", products_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
