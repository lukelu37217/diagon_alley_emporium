<!-- Hero Section -->
<div class="hero-section text-white text-center py-5 mb-5 position-relative">
  <div class="container position-relative">
    <h1 class="display-3 fw-bold mb-4">Welcome to Diagon Alley Emporium</h1>
    <p class="lead fs-4 mb-4">Discover extraordinary magical artifacts and enchanted treasures</p>
    <%= link_to "Explore Collection", products_path, class: "btn btn-light btn-lg px-4 py-3" %>
  </div>
</div>

<!-- Main Content -->
<div class="container">
  <div class="row g-4">
    <!-- Featured Products - Left Column -->
    <div class="col-lg-8">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold">Featured Artifacts</h2>
        <%= link_to "View All", products_path, class: "btn btn-outline-primary" %>
      </div>
      
      <div class="row g-4">
        <% @featured_products&.each do |product| %>
          <div class="col-md-6 mb-4">
            <div class="card product-card h-100">
              <% if product.images.attached? %>
                <%= image_tag product.images.first, class: "card-img-top", style: "height: 240px; object-fit: cover;" %>
              <% else %>
                <div class="card-img-top bg-gradient-to-br from-purple-100 to-purple-200 d-flex align-items-center justify-content-center" style="height: 240px; background: linear-gradient(135deg, #F3E8FF, #E9D5FF);">
                  <span class="text-muted fs-5">Enchanted Item</span>
                </div>
              <% end %>
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= product.name %></h5>
                <p class="card-text flex-grow-1"><%= truncate(product.description, length: 100) %></p>
                <div class="mt-auto">
                  <p class="card-text mb-2"><strong>$<%= product.current_price %></strong></p>
                  <%= link_to "View Details", product_path(product), class: "btn btn-primary" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    
    <!-- Sidebar - Right Column -->
    <div class="col-lg-4">
      <!-- Categories Section -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="card-title mb-0 fw-bold">Magical Categories</h5>
        </div>
        <div class="card-body p-0">
          <% @categories&.each do |category| %>
            <%= link_to category_path(category), class: "d-block text-decoration-none" do %>
              <div class="category-card p-3 border-bottom">
                <h6 class="fw-semibold text-dark mb-0"><%= category.name %></h6>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
      
      <!-- Quick Access Section -->
      <div class="card shadow-sm">
        <div class="card-header bg-light">
          <h5 class="card-title mb-0">Quick Access</h5>
        </div>
        <div class="card-body">
          <p class="card-text text-muted small mb-3">Administrative functions</p>
          <% if user_signed_in? && current_user.admin? %>
            <%= link_to "Admin Dashboard", admin_root_path, class: "btn btn-outline-primary btn-sm" %>
          <% else %>
            <%= link_to "Sign In", new_user_session_path, class: "btn btn-outline-primary btn-sm" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
