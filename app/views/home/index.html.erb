<div class="hero-section bg-primary text-white text-center py-5 mb-5 rounded">
  <div class="container">
    <h1 class="display-4">Welcome to Diagon Alley Emporium</h1>
    <p class="lead">Discover magical items for every witch and wizard</p>
    <%= link_to "Shop Now", products_path, class: "btn btn-light btn-lg" %>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <h2>Featured Products</h2>
    <div class="row">
      <% @featured_products&.each do |product| %>
        <div class="col-md-6 mb-4">
          <div class="card h-100">
            <% if product.images.attached? %>
              <%= image_tag product.images.first, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
            <% else %>
              <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                <span class="text-muted">🪄 Magical Item</span>
              </div>
            <% end %>
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= product.name %></h5>
              <p class="card-text flex-grow-1"><%= truncate(product.description, length: 100) %></p>
              <div class="mt-auto">
                <p class="card-text"><strong>$<%= product.current_price %></strong></p>
                <%= link_to "View Details", product_path(product), class: "btn btn-primary" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  
  <div class="col-md-4">
    <h3>Categories</h3>
    <div class="list-group">
      <% @categories&.each do |category| %>
        <%= link_to category.name, products_path(category_id: category.id), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" %>
      <% end %>
    </div>
    
    <div class="mt-4">
      <h4>Admin Access</h4>
      <p class="small text-muted">For testing purposes:</p>
      <div class="card bg-light">
        <div class="card-body">
          <p class="card-text small">
            <strong>Admin Login:</strong><br>
            Email: admin@diagonalley.com<br>
            Password: password123
          </p>
          <%= link_to "Admin Panel", admin_dashboard_index_path, class: "btn btn-sm btn-warning" %>
        </div>
      </div>
    </div>
  </div>
</div>
