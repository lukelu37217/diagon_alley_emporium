<div class="card product-card h-100">
  <% if product.images.attached? %>
    <%= image_tag product.images.first, class: "card-img-top", style: "height: 240px; object-fit: cover;" %>
  <% else %>
    <div class="card-img-top bg-gradient-to-br from-purple-100 to-purple-200 d-flex align-items-center justify-content-center" style="height: 240px; background: linear-gradient(135deg, #F3E8FF, #E9D5FF);">
      <span class="text-muted fs-5">Enchanted Item</span>
    </div>
  <% end %>
  <div class="card-body d-flex flex-column">
    <h5 class="card-title"><%= product.name %></h5>
    <p class="card-text flex-grow-1"><%= truncate(product.description, length: 100) %></p>
    <div class="mt-auto">
      <p class="card-text mb-2"><strong>$<%= product.current_price %></strong></p>
      <div class="d-grid">
        <%= link_to "View Details", product_path(product), class: "btn btn-primary" %>
      </div>
    </div>
  </div>
</div>
