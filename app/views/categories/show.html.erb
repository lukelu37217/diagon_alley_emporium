<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
      <li class="breadcrumb-item"><%= link_to "Categories", categories_path %></li>
      <li class="breadcrumb-item active"><%= @category.name %></li>
    </ol>
  </nav>
  
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= @category.name %></h1>
    <p class="text-muted"><%= pluralize(@products.count, 'product') %> found</p>
  </div>
  
  <div class="row">
    <% @products.each do |product| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <% if product.image.attached? %>
            <%= image_tag product.image, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
          <% else %>
            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
              <span class="text-muted">No Image</span>
            </div>
          <% end %>
          
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= product.name %></h5>
            <p class="card-text text-muted small">
              <%= truncate(product.description, length: 100) %>
            </p>
            <div class="mt-auto">
              <div class="d-flex justify-content-between align-items-center">
                <span class="h5 text-primary mb-0">$<%= product.price %></span>
                <%= link_to "View Details", product_path(product), class: "btn btn-outline-primary btn-sm" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  
  <% if @products.empty? %>
    <div class="text-center py-5">
      <h3>No products in this category yet</h3>
      <p class="text-muted">Check back later for magical items!</p>
      <%= link_to "Browse All Products", products_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
