<div class="container mt-4">
  <div class="row">
    <div class="col-md-9">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>All Products</h1>
        <p class="text-muted"><%= @products.count %> products found</p>
      </div>
      
      <div class="row">
        <% @products.each do |product| %>
          <div class="col-md-4 mb-4">
            <div class="card h-100">
              <% if product.images.attached? %>
                <%= image_tag product.images.first, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
              <% else %>
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                  <span class="text-muted">No Image</span>
                </div>
              <% end %>
              
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= product.name %></h5>
                <p class="card-text text-muted small">
                  <%= truncate(product.description, length: 100) %>
                </p>
                <div class="mt-auto">
                  <div class="d-flex justify-content-between align-items-center">
                    <span class="h5 text-primary mb-0">$<%= product.price %></span>
                    <%= link_to "View Details", product_path(product), class: "btn btn-outline-primary btn-sm" %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    
    <div class="col-md-3">
      <div class="card">
        <div class="card-header">
          <h5>Categories</h5>
        </div>
        <div class="card-body">
          <%= link_to "All Products", products_path, class: "btn btn-link p-0 text-start d-block" %>
          <% @categories.each do |category| %>
            <%= link_to category.name, category_path(category), class: "btn btn-link p-0 text-start d-block" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
