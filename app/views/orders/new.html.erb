<div class="container mt-4">
  <h2>Checkout</h2>
  
  <div class="row">
    <div class="col-md-8">
      <%= form_with model: @order, local: true, class: "needs-validation", novalidate: true, data: { turbo: false } do |f| %>
        <div class="card mb-4">
          <div class="card-header">
            <h5>Shipping Information</h5>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label for="order_shipping_address" class="form-label">Shipping Address</label>
              <textarea name="order[shipping_address]" id="order_shipping_address" class="form-control" rows="3" required placeholder="Enter your complete shipping address"></textarea>
              <div class="invalid-feedback">
                Please provide a shipping address.
              </div>
            </div>
            
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="order_city" class="form-label">City</label>
                  <input type="text" name="order[city]" id="order_city" class="form-control" required placeholder="e.g., Toronto">
                  <div class="invalid-feedback">
                    Please provide a city.
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="order_postal_code" class="form-label">Postal Code</label>
                  <input type="text" name="order[postal_code]" id="order_postal_code" class="form-control" required pattern="[A-Za-z][0-9][A-Za-z] [0-9][A-Za-z][0-9]" placeholder="e.g., M5V 3A8">
                  <div class="invalid-feedback">
                    Please provide a valid postal code (e.g., A1A 1A1).
                  </div>
                </div>
              </div>
            </div>
            
            <div class="mb-3">
              <%= f.label :province, "Province/Territory", class: "form-label" %>
              <%= f.select :province, 
                  options_for_select([
                    ['Alberta', 'AB'],
                    ['British Columbia', 'BC'],
                    ['Manitoba', 'MB'],
                    ['New Brunswick', 'NB'],
                    ['Newfoundland and Labrador', 'NL'],
                    ['Northwest Territories', 'NT'],
                    ['Nova Scotia', 'NS'],
                    ['Nunavut', 'NU'],
                    ['Ontario', 'ON'],
                    ['Prince Edward Island', 'PE'],
                    ['Quebec', 'QC'],
                    ['Saskatchewan', 'SK'],
                    ['Yukon', 'YT']
                  ], 'ON'), 
                  { prompt: "Select Province/Territory" }, 
                  { class: "form-select", required: true, id: "province_select" } %>
              <div class="invalid-feedback">
                Please select your province/territory.
              </div>
            </div>
            
            <div class="mb-3">
              <label for="order_billing_address" class="form-label">Billing Address</label>
              <textarea name="order[billing_address]" id="order_billing_address" class="form-control" rows="3" required placeholder="Enter your complete billing address"></textarea>
              <div class="invalid-feedback">
                Please provide a billing address.
              </div>
              <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="sameAsShipping">
                <label class="form-check-label" for="sameAsShipping">
                  Same as shipping address
                </label>
              </div>
            </div>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-header">
            <h5>Payment Method</h5>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <%= f.select :payment_method, 
                  options_for_select([
                    ['Credit Card', 'credit_card'],
                    ['PayPal', 'paypal'],
                    ['Bank Transfer', 'bank_transfer']
                  ]), 
                  { prompt: "Select payment method" }, 
                  { class: "form-select", required: true } %>
              <div class="invalid-feedback">
                Please select a payment method.
              </div>
            </div>
          </div>
        </div>
        
        <div class="d-grid gap-2">
          <%= f.submit "Place Order", class: "btn btn-primary btn-lg", id: "place-order-btn", 
              data: { disable_with: "Processing Order..." } %>
          <%= link_to "Back to Cart", shopping_carts_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
    
    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5>Order Summary</h5>
        </div>
        <div class="card-body">
          <% @cart_items.each do |item| %>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <div>
                <span><%= item.product.name %></span>
                <small class="text-muted"> x <%= item.quantity %></small>
              </div>
              <span>$<%= number_with_precision(item.product.current_price * item.quantity, precision: 2) %></span>
            </div>
          <% end %>
          
          <hr>
          
          <!-- Tax Calculation Preview -->
          <div id="tax-breakdown" style="display: none;">
            <div class="d-flex justify-content-between">
              <span>Subtotal:</span>
              <span id="subtotal-amount">$<%= number_with_precision(@total, precision: 2) %></span>
            </div>
            
            <div id="gst-line" class="d-flex justify-content-between" style="display: none;">
              <span>GST (<span id="gst-rate">5</span>%):</span>
              <span id="gst-amount">$0.00</span>
            </div>
            
            <div id="pst-line" class="d-flex justify-content-between" style="display: none;">
              <span>PST (<span id="pst-rate">7</span>%):</span>
              <span id="pst-amount">$0.00</span>
            </div>
            
            <div id="hst-line" class="d-flex justify-content-between" style="display: none;">
              <span>HST (<span id="hst-rate">13</span>%):</span>
              <span id="hst-amount">$0.00</span>
            </div>
            
            <hr>
          </div>
          
          <div class="d-flex justify-content-between">
            <strong>Total: <span id="total-amount">$<%= number_with_precision(@total, precision: 2) %></span></strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const subtotal = <%= @total %>;
  
  // Tax calculation function
  function calculateTaxes(province) {
    let gst = 0, pst = 0, hst = 0;
    let gstRate = 0, pstRate = 0, hstRate = 0;
    
    switch(province) {
      case 'ON': // Ontario
        hst = subtotal * 0.13;
        hstRate = 13;
        break;
      case 'BC':
      case 'SK': // British Columbia, Saskatchewan
        gst = subtotal * 0.05;
        pst = subtotal * 0.07;
        gstRate = 5;
        pstRate = 7;
        break;
      case 'MB': // Manitoba
        gst = subtotal * 0.05;
        pst = subtotal * 0.07;
        gstRate = 5;
        pstRate = 7;
        break;
      case 'QC': // Quebec
        gst = subtotal * 0.05;
        pst = subtotal * 0.09975;
        gstRate = 5;
        pstRate = 9.975;
        break;
      case 'AB':
      case 'NT':
      case 'NU':
      case 'YT': // Alberta, Northwest Territories, Nunavut, Yukon
        gst = subtotal * 0.05;
        gstRate = 5;
        break;
      case 'NB':
      case 'NL':
      case 'NS':
      case 'PE': // New Brunswick, Newfoundland, Nova Scotia, Prince Edward Island
        hst = subtotal * 0.15;
        hstRate = 15;
        break;
      default:
        gst = subtotal * 0.05;
        gstRate = 5;
    }
    
    return {
      gst: gst,
      pst: pst,
      hst: hst,
      gstRate: gstRate,
      pstRate: pstRate,
      hstRate: hstRate,
      totalTax: gst + pst + hst,
      grandTotal: subtotal + gst + pst + hst
    };
  }
  
  // Update tax display
  function updateTaxDisplay(province) {
    const taxes = calculateTaxes(province);
    const taxBreakdown = document.getElementById('tax-breakdown');
    const gstLine = document.getElementById('gst-line');
    const pstLine = document.getElementById('pst-line');
    const hstLine = document.getElementById('hst-line');
    
    // Show tax breakdown
    taxBreakdown.style.display = 'block';
    
    // Update amounts
    document.getElementById('gst-amount').textContent = '$' + taxes.gst.toFixed(2);
    document.getElementById('pst-amount').textContent = '$' + taxes.pst.toFixed(2);
    document.getElementById('hst-amount').textContent = '$' + taxes.hst.toFixed(2);
    document.getElementById('total-amount').textContent = '$' + taxes.grandTotal.toFixed(2);
    
    // Update rates
    document.getElementById('gst-rate').textContent = taxes.gstRate;
    document.getElementById('pst-rate').textContent = taxes.pstRate;
    document.getElementById('hst-rate').textContent = taxes.hstRate;
    
    // Show/hide appropriate tax lines
    gstLine.style.display = taxes.gst > 0 ? 'flex' : 'none';
    pstLine.style.display = taxes.pst > 0 ? 'flex' : 'none';
    hstLine.style.display = taxes.hst > 0 ? 'flex' : 'none';
  }
  
  // Province change handler
  document.getElementById('province_select').addEventListener('change', function() {
    if (this.value) {
      updateTaxDisplay(this.value);
    }
  });
  
  // Copy shipping address to billing address
  document.getElementById('sameAsShipping').addEventListener('change', function() {
    const shippingAddress = document.getElementById('order_shipping_address');
    const billingAddress = document.getElementById('order_billing_address');
    
    if (this.checked) {
      billingAddress.value = shippingAddress.value;
    } else {
      billingAddress.value = '';
    }
  });

  // Bootstrap form validation
  (function() {
    'use strict';
    window.addEventListener('load', function() {
      var forms = document.getElementsByClassName('needs-validation');
      var validation = Array.prototype.filter.call(forms, function(form) {
        form.addEventListener('submit', function(event) {
          console.log('Form submit event triggered');
          console.log('Form validity:', form.checkValidity());
          
          if (form.checkValidity() === false) {
            console.log('Form validation failed');
            event.preventDefault();
            event.stopPropagation();
          } else {
            console.log('Form validation passed, submitting...');
          }
          form.classList.add('was-validated');
        }, false);
      });
    }, false);
  })();
  
  // Initialize tax display with Ontario as default
  document.addEventListener('DOMContentLoaded', function() {
    const provinceSelect = document.getElementById('province_select');
    if (provinceSelect.value) {
      updateTaxDisplay(provinceSelect.value);
    } else {
      updateTaxDisplay('ON'); // Default to Ontario
    }
  });
</script>
