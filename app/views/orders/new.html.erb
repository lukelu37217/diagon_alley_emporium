<div class="container mt-4">
  <h2>Checkout</h2>
  
  <div class="row">
    <div class="col-md-8">
      <%= form_with model: @order, local: true, class: "needs-validation", novalidate: true do |f| %>
        <div class="card mb-4">
          <div class="card-header">
            <h5>Shipping Information</h5>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <%= f.label :shipping_address, "Shipping Address", class: "form-label" %>
              <%= f.text_area :shipping_address, class: "form-control", rows: 3, required: true %>
              <div class="invalid-feedback">
                Please provide a shipping address.
              </div>
            </div>
            
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :city, "City", class: "form-label" %>
                  <%= f.text_field :city, class: "form-control", required: true %>
                  <div class="invalid-feedback">
                    Please provide a city.
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <%= f.label :postal_code, "Postal Code", class: "form-label" %>
                  <%= f.text_field :postal_code, class: "form-control", required: true, pattern: "[A-Za-z][0-9][A-Za-z] [0-9][A-Za-z][0-9]" %>
                  <div class="invalid-feedback">
                    Please provide a valid postal code (e.g., A1A 1A1).
                  </div>
                </div>
              </div>
            </div>
            
            <div class="mb-3">
              <%= f.label :province, "Province/Territory", class: "form-label" %>
              <%= f.select :province, 
                  options_for_select([
                    ['Alberta', 'AB'],
                    ['British Columbia', 'BC'],
                    ['Manitoba', 'MB'],
                    ['New Brunswick', 'NB'],
                    ['Newfoundland and Labrador', 'NL'],
                    ['Northwest Territories', 'NT'],
                    ['Nova Scotia', 'NS'],
                    ['Nunavut', 'NU'],
                    ['Ontario', 'ON'],
                    ['Prince Edward Island', 'PE'],
                    ['Quebec', 'QC'],
                    ['Saskatchewan', 'SK'],
                    ['Yukon', 'YT']
                  ], 'ON'), 
                  { prompt: "Select Province/Territory" }, 
                  { class: "form-select", required: true, id: "province_select" } %>
              <div class="invalid-feedback">
                Please select your province/territory.
              </div>
            </div>
            
            <div class="mb-3">
              <%= f.label :billing_address, "Billing Address", class: "form-label" %>
              <%= f.text_area :billing_address, class: "form-control", rows: 3, required: true %>
              <div class="invalid-feedback">
                Please provide a billing address.
              </div>
              <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="sameAsShipping">
                <label class="form-check-label" for="sameAsShipping">
                  Same as shipping address
                </label>
              </div>
            </div>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-header">
            <h5>Payment Method</h5>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <%= f.select :payment_method, 
                  options_for_select([
                    ['Credit Card', 'credit_card'],
                    ['PayPal', 'paypal'],
                    ['Bank Transfer', 'bank_transfer']
                  ]), 
                  { prompt: "Select payment method" }, 
                  { class: "form-select", required: true } %>
              <div class="invalid-feedback">
                Please select a payment method.
              </div>
            </div>
          </div>
        </div>
        
        <div class="d-grid gap-2">
          <%= f.submit "Place Order", class: "btn btn-primary btn-lg" %>
          <%= link_to "Back to Cart", shopping_carts_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
    
    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5>Order Summary</h5>
        </div>
        <div class="card-body">
          <% @cart_items.each do |item| %>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <div>
                <span><%= item.product.name %></span>
                <small class="text-muted"> x <%= item.quantity %></small>
              </div>
              <span>$<%= (item.product.current_price * item.quantity).to_f %></span>
            </div>
          <% end %>
          
          <hr>
          <div class="d-flex justify-content-between">
            <strong>Total: $<%= @total.to_f %></strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Copy shipping address to billing address
  document.getElementById('sameAsShipping').addEventListener('change', function() {
    const shippingAddress = document.getElementById('order_shipping_address');
    const billingAddress = document.getElementById('order_billing_address');
    const shippingCity = document.getElementById('order_city');
    const shippingPostalCode = document.getElementById('order_postal_code');
    
    if (this.checked) {
      billingAddress.value = shippingAddress.value;
      // Note: In a real application, you might want separate billing city/postal fields
    } else {
      billingAddress.value = '';
    }
  });

  // Bootstrap form validation
  (function() {
    'use strict';
    window.addEventListener('load', function() {
      var forms = document.getElementsByClassName('needs-validation');
      var validation = Array.prototype.filter.call(forms, function(form) {
        form.addEventListener('submit', function(event) {
          if (form.checkValidity() === false) {
            event.preventDefault();
            event.stopPropagation();
          }
          form.classList.add('was-validated');
        }, false);
      });
    }, false);
  })();
</script>
